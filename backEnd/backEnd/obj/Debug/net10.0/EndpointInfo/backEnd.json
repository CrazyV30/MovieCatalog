  "components": {
    "schemas": {
      "CreateMovieRequest": {
        "required": [
          "title",
          "description",
          "photoPath",
          "runtime",
          "director",
          "releaseYear"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "photoPath": {
            "type": "string",
            "format": "uri"
          },
          "runtime": {
            "pattern": "^0?[012]:[0-5][0-9]$",
            "type": "string"
          },
          "director": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "releaseYear": {
            "maximum": 2026,
            "minimum": 1800,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
